<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Vehicle SDK: 제품 경로가 쓰는 권한만 선언합니다. 승인되지 않은 권한이 있으면 심사를 통과할 수 없습니다. -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />

    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- AAOS 표준 차량 속도 (Pleos 정책상 허용 여부 확인 필요) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- 낮밤 모드(uiMode)가 바뀌어도 홈을 다시 만들지 않습니다. 밤 화면은 시계로 그립니다. -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 정령 입양식과 가족 정령 관리. 주차 중에만 쓰며 출발하면 스스로 닫힙니다.
             밤 모양이 없어 낮밤 모드(uiMode)가 바뀌어도 다시 만들지 않습니다.
             고르던 단계, 확인 창, 환영 낭독이 끊기지 않습니다. -->
        <activity
            android:name=".ui.family.FamilyActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="false"
            android:label="가족 정령" />

        <!-- 강가: 홈에서 왼쪽으로 넘기면 오는 두 번째 장소. 주차 중에만 쓰며 출발하면 스스로 닫힙니다.
             밤은 홈처럼 시계로 그려 낮밤 모드(uiMode)가 바뀌어도 다시 만들지 않습니다.
             열어 둔 고르기 칸과 방금 한 말이 남습니다. -->
        <activity
            android:name=".ui.river.RiverActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="false"
            android:label="강가" />

        <activity
            android:name=".ui.book.BookActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:label="기록" />

        <!-- 회상 그림책. 주차 중에만 열리고 출발하면 스스로 닫힙니다. -->
        <activity
            android:name=".ui.recall.RecallActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:label="회상" />

        <!-- 가족에게 보내는 엽서. 주차 중에만 쓰며 출발하면 스스로 닫힙니다.
             빠르게 두 번 눌러도 두 겹으로 쌓이지 않게 singleTop으로 둡니다.
             두 번째 요청은 위에 뜬 엽서가 받고 버립니다. 여는 쪽 막이를 놓쳤을 때의 둘째 막이입니다. -->
        <activity
            android:name=".ui.share.PostcardActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:label="엽서"
            android:launchMode="singleTop" />

        <!-- 도착 카드: 트립 종료(P)에 서비스가 띄우고, D로 바뀌면 스스로 닫힙니다.
             창 크기나 낮밤 모드가 바뀌어도 재생성되면 일기를 다시 읽으므로 configChanges로 직접 처리합니다. -->
        <activity
            android:name=".ui.arrival.ArrivalCardActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="도착 카드"
            android:launchMode="singleTop" />

        <!-- 주행 중에도 차량 신호를 수집하는 백그라운드 서비스 (방치형의 핵심) -->
        <service
            android:name=".spike.VehicleProbeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous vehicle signal monitoring for an in-car companion diary" />
        </service>

        <receiver
            android:name=".spike.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Gleo Interface: component="service" 액션은 broadcast로 전달됩니다. -->
        <receiver
            android:name=".spike.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="GET_PET_STATUS" />
                <action android:name="GET_VEHICLE_HEALTH" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
